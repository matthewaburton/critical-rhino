# Critical Rhino, dark, for Ghostty.
# Generated by scripts/build_ghostty.py from palette.toml; don't edit by hand.

background = #202020
foreground = #F7EEDC

# ANSI colors. The normals are text (4.5:1); the brights are lighter accents (3:1).
palette = 0=#322F2E
palette = 1=#E66E72
palette = 2=#76A041
palette = 3=#FDD172
palette = 4=#7895BC
palette = 5=#BD80AA
palette = 6=#2AA497
palette = 7=#979290
palette = 8=#797473
palette = 9=#FFA1A5
palette = 10=#A9D374
palette = 11=#FFFFA5
palette = 12=#ABC8EF
palette = 13=#F0B3DD
palette = 14=#5DD7CA
palette = 15=#F7EEDC

# Selected text keeps its own color; every text color reads on the selection.
selection-background = #0D293E
selection-foreground = cell-foreground

# The character under a block cursor is black or cream, whichever reads on it.
cursor-color = #7895BC
cursor-text = #202020

# Search matches, the same highlights as in the editors.
search-background = #FDD172
search-foreground = #202020
search-selected-background = #E37523
search-selected-foreground = #202020

# Bold text in the bright colors, which here read at least as well as the normals.
bold-color = bright

# Faint text at the lowest opacity that keeps every text color at 3:1, however it's blended.
faint-opacity = 0.65

split-divider-color = #504C4B
